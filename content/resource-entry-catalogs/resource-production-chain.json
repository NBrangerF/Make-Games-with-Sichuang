  "entry": {
    "id": "resource-production-chain",
    "title": "诊断资源转换、生产链、维护与经济闭环",
    "question": "经济循环重复、某资源总卡住、收入总算错、维护令人崩溃、引擎后期爆产或终局留下无用库存；我该改比率、来源、容量、衰减还是回本速度？",
    "outcome": "先分开存量、变化率与结算点，追踪一件资源从来源经池和转换到消耗或残值；补全顺序、容量、维护、债务与衰减，再只改一个经济字段。",
    "resourceIds": [
      "agricola-resource-cycle-rules",
      "le-havre-production-chain-rules",
      "race-galaxy-produce-consume-rules",
      "terraforming-mars-production-rules",
      "daniel-engines-resource-web",
      "machinations-economy-nodes",
      "stock-flow-failure-study",
      "terraforming-mars-accessibility"
    ],
    "evidenceBoundary": "组合正式规则、设计师方法、系统动力学与相邻研究、无障碍长评和玩家症状；它们支持分开存量/流量、写完整转换与维护协议、追踪容量/衰减/债务/残值/回本，并以真实任务验证状态恢复，不提供最佳资源数、比率、产能、维护、容量、腐坏、回本或偏好。"
  },
