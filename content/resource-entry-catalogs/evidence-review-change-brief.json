  "entry": {
    "id": "evidence-review-change-brief",
    "title": "把一场测试变成有边界的发现与下一版简报",
    "question": "现场测试已经结束，但笔记、玩家建议和我的解释混在一起；怎样既不丢证据，也不让出现次数自动替我决定改什么？",
    "outcome": "显式承接一场已完成会话，选择原事件与局后回答，写发现的条件、反证和缺失，再比较候选方案，形成保持项、单一变化轴、回退信号与下一问题。",
    "resourceIds": [
      "games-user-research-analysis",
      "games-user-research-debriefing",
      "govuk-analyse-research-session",
      "govuk-rainbow-spreadsheet",
      "tricorn-playtesting-with-purpose",
      "woodard-effective-playtest",
      "boardssey-review-results",
      "ixdf-affinity-diagram"
    ],
    "evidenceBoundary": "组合游戏用户研究、英国公共服务、桌游设计师、产品帮助中心与通用 UX 分组方法；它们支持观察—发现—行动分层、来源回查、候选方案比较和复测，不提供自动洞察、严重度、频次优先级、因果证明、唯一修法或静默项目写回。"
  },
