{
  "schemaVersion": 1,
  "contentVersion": "3.0.0",
  "parts": [
    {
      "id": "starting",
      "title": {
        "zh-CN": "从一局游戏，找到设计的起点",
        "en": "Find a starting point in one game"
      },
      "introduction": {
        "zh-CN": "从一份完整规则看见动作与局面，再观察谁会来玩、他们在什么场合玩。带着这些条件，为自己的第一份草稿写下暂定方向。",
        "en": "Start with a complete game and observe its actions and situations. Consider who might play and where, then use those conditions to choose a provisional direction for your own draft."
      }
    },
    {
      "id": "actions",
      "title": {
        "zh-CN": "让想法变成能做的动作",
        "en": "Turn an idea into actions"
      },
      "introduction": {
        "zh-CN": "把一个宽泛的点子展开成几种办法，选出能执行的动作。用纸片跟过一次结算，再看这些动作为什么值得选择。",
        "en": "Explore several ways to realize an idea, then turn one into actions. Follow their resolution with paper pieces and examine why the choices might matter."
      }
    },
    {
      "id": "decisions",
      "title": {
        "zh-CN": "看清规则怎样改变决定",
        "en": "See how rules change decisions"
      },
      "introduction": {
        "zh-CN": "回到熟悉的河岸，分别改变消息、木板、路线和行动时间。每次走完一个具体比较，看清局面和可做的事怎样一起变化。",
        "en": "Return to the river and vary information, planks, paths, and timing. Work through each comparison to see how a situation changes what players can do."
      }
    },
    {
      "id": "systems",
      "title": {
        "zh-CN": "让各部分一起工作",
        "en": "Make the parts work together"
      },
      "introduction": {
        "zh-CN": "已经看过单条规则，现在让它们一起工作：资源从哪里来，目标怎样推动结束，两条机制怎样配合，以及一起赢时谁在作决定。",
        "en": "Connect the rules: where resources come from, how goals lead toward an ending, how mechanisms work together, and who makes decisions when players share a win."
      }
    },
    {
      "id": "meaning",
      "title": {
        "zh-CN": "看见不同玩家的游戏",
        "en": "See the game from different players’ perspectives"
      },
      "introduction": {
        "zh-CN": "从比较一个办法的优势，走到玩家怎样理解自己的行动。再检查故事表达了什么，以及怎样把这些关系写成别人能用的说明。",
        "en": "Compare advantages under clear conditions, then examine how players interpret their actions. Consider what the story expresses and how to communicate these relationships in usable instructions."
      }
    },
    {
      "id": "testing",
      "title": {
        "zh-CN": "把问题摆到桌上",
        "en": "Put a question on the table"
      },
      "introduction": {
        "zh-CN": "先看具体参与者怎样读、拿和决定，再按本轮问题选择原型的精度。安排一次试玩，并跟着一个假想过程，分清发生的事与可能原因。",
        "en": "Consider how particular people read, handle pieces, and decide. Choose the accuracy a prototype needs for the question, plan a playtest, and follow a hypothetical session to separate events from explanations."
      }
    },
    {
      "id": "revising",
      "title": {
        "zh-CN": "改好一版，交给下一位玩家",
        "en": "Revise a version and hand it over"
      },
      "introduction": {
        "zh-CN": "把几份反馈放回各自局面，决定下一稿先改哪里。给出完整材料，检验它能否独立使用，再整理一个别人可以接续的版本。",
        "en": "Return several comments to their situations and choose a revision. Provide a complete set of materials, check independent use, and prepare a version others can continue developing."
      }
    }
  ],
