  "parts": [
    {
      "id": "starting",
      "title": {
        "zh-CN": "从熟悉的一局开始",
        "en": "Begin with a familiar game"
      },
      "introduction": {
        "zh-CN": "先玩一段小赛跑，观察桌边的人，再写下自己想改的一件事。",
        "en": "Try a small race, watch the people playing, and choose one thing you want to change."
      }
    },
    {
      "id": "actions",
      "title": {
        "zh-CN": "把点子写成动作",
        "en": "Turn ideas into actions"
      },
      "introduction": {
        "zh-CN": "多一颗骰子会改变什么？从选定点数，一直走到回合结束。",
        "en": "What changes with another die? Follow the choice through to the end of the turn."
      }
    },
    {
      "id": "decisions",
      "title": {
        "zh-CN": "在前进里找出选择",
        "en": "Look inside the race"
      },
      "introduction": {
        "zh-CN": "点数什么时候揭晓，重掷机会要不要花，轮到别人时又在等什么。",
        "en": "When results appear, whether to spend a reroll, and what happens while someone else takes a turn."
      }
    },
    {
      "id": "systems",
      "title": {
        "zh-CN": "看看规则怎样互相影响",
        "en": "See how rules affect each other"
      },
      "introduction": {
        "zh-CN": "加入补给、改变终点、试着合作，把每个改法放回棋盘走一遍。",
        "en": "Try replenishment, another finish, and a shared goal. Put each proposal on the board and follow it."
      }
    },
    {
      "id": "meaning",
      "title": {
        "zh-CN": "让人看懂，也愿意玩",
        "en": "Make a game people can follow"
      },
      "introduction": {
        "zh-CN": "从人数、主题和组件，检查玩家怎样理解并使用同一套规则。",
        "en": "Use player count, theme, and components to examine how people understand and use the rules."
      }
    },
    {
      "id": "testing",
      "title": {
        "zh-CN": "把草稿拿给人试",
        "en": "Put the draft in someone’s hands"
      },
      "introduction": {
        "zh-CN": "找一个具体问题，准备材料，看看别人实际怎样做。",
        "en": "Choose a specific question, prepare the materials, and watch someone use them."
      }
    },
    {
      "id": "revising",
      "title": {
        "zh-CN": "改好一稿，再交出去",
        "en": "Revise a draft and hand it over"
      },
      "introduction": {
        "zh-CN": "从反馈里找到改法，整理完整规则，给下一位玩家留一个清楚的开始。",
        "en": "Find a revision in the feedback, assemble complete rules, and give the next player a clear place to start."
      }
    }
  ],
